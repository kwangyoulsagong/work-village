{
  "manifest_version": 3,
  "name": "작은 마을",
  "version": "1.1.0",
  "description": "Claude·Codex 사용량(없으면 브라우저를 켜 둔 시간)만큼 자라는 작은 마을. 캐릭터가 알아서 농사짓고 집을 짓고 이웃과 살아요.",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "sidePanel",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "작은 마을 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
